# ODrive environment template.
# Copy to .env.local for local development. NEVER commit secrets.
# In production, only the non-secret CONFIG block belongs in wrangler vars;
# everything under SECRETS must be stored as Cloudflare Worker Secrets.

# ---------- CONFIG (non-secret) ----------
ENVIRONMENT=development
APP_URL=http://localhost:8080

# Database / auth HTTP endpoint + publishable (anon) key.
# Publishable keys are browser-safe by design.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_PROJECT_ID=your-project-ref

# Browser-exposed copies (build-time). Same values as above, never secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---------- SECRETS (never commit, never put in wrangler vars) ----------
SUPABASE_SERVICE_ROLE_KEY=replace-me
ODRIVE_ENCRYPTION_KEY=generate-a-long-random-passphrase

# Email delivery
LOVABLE_API_KEY=replace-me
LOVABLE_SEND_URL=

# Scheduled invocations
LOVABLE_CRON_SECRET=replace-me
LOVABLE_CRON_SECRET_PREVIOUS=

# Storage provider OAuth clients (only what you actually enable)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

